POSTGRES_USER=iot_user
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=smart_fan_db

INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=REPLACE_WITH_LOCAL_INFLUXDB_PASSWORD
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=REPLACE_WITH_LOCAL_INFLUXDB_TOKEN

APP_TIMEZONE=America/Sao_Paulo
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# Optional separate administration token; never given to the backend.
# INFLUXDB_ADMIN_TOKEN=REPLACE_WITH_LOCAL_ADMIN_TOKEN
# Overrides for running the backend outside Docker:
# POSTGRES_HOST=127.0.0.1
# INFLUXDB_URL=http://127.0.0.1:8086
# MQTT_BROKER=127.0.0.1
VITE_DEVICE_ID=esp32_fan_01
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
